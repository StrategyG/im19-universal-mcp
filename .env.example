# Never commit a populated .env file. Use a production secrets manager.
# Switch to production ONLY after institutional release gates are met.
# Runtime defaults to production and enforces PostgreSQL/security constraints.
IM19_DEPLOYMENT_ENV=staging
IM19_DATABASE_URL=postgresql+psycopg://im19:change_me@postgres:5432/im19
# Generate once using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IM19_FERNET_KEY=
# Temporarily supply only during offline key migration; remove after verification.
# Comma-separated Fernet keys previously used to encrypt database rows.
IM19_FERNET_PREVIOUS_KEYS=
# Set to YES only when gateway and all writers are offline, after a verified backup.
IM19_OFFLINE_MAINTENANCE=
IM19_AUDIT_SALT=
# Google OAuth Web Application client credentials, from Google Cloud Console
IM19_GOOGLE_CLIENT_ID=
IM19_GOOGLE_CLIENT_SECRET=
IM19_GOOGLE_REDIRECT_URI=https://mcp.example.com/oauth/google/callback
# Separate OAuth resource-server identity provider for ChatGPT -> MCP
IM19_MCP_ISSUER=https://identity.example.com/
IM19_MCP_RESOURCE=https://mcp.example.com/mcp
IM19_MCP_INTROSPECTION=https://identity.example.com/oauth2/introspect
IM19_MCP_CLIENT_ID=
IM19_MCP_CLIENT_SECRET=
# Dedicated confidential client at the SAME issuer for browser identity proof.
# Register https://mcp.example.com/oauth/browser/callback as its exact redirect.
# IdP must support Authorization Code + PKCE, resource indicators and introspection.
IM19_BROWSER_AUTHORIZATION=https://identity.example.com/oauth2/authorize
IM19_BROWSER_TOKEN=https://identity.example.com/oauth2/token
IM19_BROWSER_CLIENT_ID=
IM19_BROWSER_CLIENT_SECRET=
# Server bound to loopback behind a TLS reverse proxy
IM19_BIND_HOST=127.0.0.1
IM19_PORT=8000
# Local stdio development only; never set in a remote gateway
IM19_DEV_SUBJECT=

